# Packages that need an explicit reference when cross-compiling RBesT to
# WebAssembly. Read by tools/webr/build-rwasm.R; see
# design/howto-build-rbest-webr.md section 3.1 for the full background.
#
# Deliberately version-free. `build-rwasm.R` looks each name up in the
# `PACKAGES` index of the configured repositories and creates a pinned
# `<pkg>=url::<artifact>` reference for the highest version it finds, retaining
# a repository's content-addressed artifact URL when one is advertised.
# Nothing here has to be edited when r-universe
# rebuilds rstan, and nothing has to be edited when CRAN eventually catches
# up either -- whichever repository carries the higher version wins.
#
# Why explicit `url::` references at all, rather than plain package names:
#
#   * A plain name resolves to *one candidate per repository*, and
#     `rwasm:::update_repo()` builds every resolved row -- so rstan would be
#     cross-compiled once for CRAN and once for r-universe.
#   * A version floor (`rstan@>=2.39`) is not an option: pkgdepends rejects
#     it with "Version ranges are not implemented yet."
#   * A GitHub reference is not an option either. `stan-dev/rstan` keeps the
#     Stan library in a git submodule (`StanHeaders/inst/include/upstream`),
#     and GitHub tarballs omit submodule content; the r-universe tarballs are
#     built from a full clone and do contain it.

# Resolved to a pinned `url::` reference at build time and passed to
# `rwasm::add_pkg(remotes = )`, which rewrites the download source of a package
# already present in the dependency graph.
#
#   StanHeaders, rstan  The webR build requires both at >= 2.39. The highest
#                       version across CRAN and the stan-dev r-universe wins;
#                       they need not come from the same repository.
#
# These must be overrides rather than direct references. Both are already hard
# dependencies of RBesT, and a package that is *both* a direct reference and a
# transitive dependency resolves to two rows -- one per role -- and
# `rwasm:::update_repo()` builds every row it is given, so rstan (the most
# expensive package in the closure by far) would be cross-compiled twice.
# Supplied through `remotes` it stays a single row whose source is redirected.
Remote-Refs: StanHeaders,
    rstan

# Resolved to a pinned `url::` reference at build time and added as a direct
# package reference.
#
#   codetools   A Recommended package, so it is not in RBesT's Imports closure
#               and cannot be supplied through `remotes` -- that only rewrites
#               packages already in the graph. Without it, loading rstan's Rcpp
#               modules warns "code for methods in class 'Rcpp_stan_fit' was
#               not checked ...". CRAN is its only source.
Source-Refs: codetools

# Passed through to pkgdepends verbatim.
#
#   codetools=?source   Not a duplicate of the entry above, and not optional.
#                       For any of the 15 Recommended package names present in
#                       the host R's `.Library`, pkgdepends' resolver injects
#                       an *additional* `installed::<.Library>/<pkg>` candidate,
#                       keyed only on the package name and not deduplicated
#                       against refs already given for it. That candidate
#                       cannot satisfy `platforms = "source"`, because webR's R
#                       is built with `--with-recommended-packages=no`, and
#                       resolution fails. The `?source` parameter form sets
#                       `want_source = TRUE` on every edge resolving to that
#                       name, which is the condition checked before the
#                       injection happens, so it is skipped. It supplies no
#                       tarball of its own -- hence the pairing.
Extra-Refs: codetools=?source

# Installed into the *host* R library before the wasm build starts.
#
#   StanHeaders   `rwasm:::wasm_build()` additionally installs each package's
#                 dependencies into the host library via
#                 `pak::pkg_install("deps::<tarball>")`, so that rstan's
#                 configure and build scripts can find StanHeaders' headers.
#                 That call only consults `getOption("repos")`. Installing it
#                 up front from the resolved URL means the resolution repos can
#                 stay CRAN-only, which is what keeps packages carried by both
#                 CRAN and the stan-dev r-universe (bayesplot, loo, posterior,
#                 rstan, rstantools, StanHeaders) from resolving twice and
#                 being cross-compiled twice.
Host-Refs: StanHeaders
