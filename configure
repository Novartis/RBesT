#! /bin/sh

# Generated by rstantools.  Do not edit by hand.

# Every step below is load-bearing for the WebAssembly build, and each one of
# them used to be able to fail without failing this script: the exit status of
# a `sh` script is that of its last command, which is the `for` loop at the
# bottom. A silently skipped step produced an RBesT.so that built, installed
# and shipped, and only failed when webR tried to `dlopen()` it. Fail here
# instead, loudly, with a message naming the step.
set -e

"${R_HOME}/bin/Rscript" -e "rstantools::rstan_config()"

# src/ is generated in full by rstan_config() above, so hand-written sources
# cannot live there. inst/webr/tbb-stubs.cpp defines the two Intel TBB runtime
# entry points that Stan math instantiates through headers; without them the
# WebAssembly build of RBesT cannot be dlopen()ed in webR at all. The file
# guards itself with #ifdef __EMSCRIPTEN__, so on every other platform this is
# an empty translation unit and the copy is inert. See that file and
# design/howto-build-rbest-webr.md section 9.
#
# Checked rather than assumed, in the same spirit as
# tools/webr/patch-rstan-tarball.R, which verifies that rstan's own Makevars
# still globs its sources before relying on that. R CMD INSTALL globs src/ for
# sources *after* this script runs, so a file that lands here is compiled and
# linked into RBesT.so; a file that does not is missed in silence.
if [ ! -f inst/webr/tbb-stubs.cpp ]; then
  echo "configure: inst/webr/tbb-stubs.cpp is missing from the package sources." >&2
  echo "configure: the WebAssembly build needs it; see design/howto-build-rbest-webr.md section 9." >&2
  exit 1
fi
if [ ! -d src ]; then
  echo "configure: rstantools::rstan_config() did not create src/." >&2
  exit 1
fi
cp inst/webr/tbb-stubs.cpp src/webr-tbb-stubs.cpp
if [ ! -s src/webr-tbb-stubs.cpp ]; then
  echo "configure: failed to install src/webr-tbb-stubs.cpp." >&2
  exit 1
fi
echo "configure: installed src/webr-tbb-stubs.cpp (TBB stubs, active under Emscripten only)"

# When cross-compiling for WebAssembly (see tools/webr/build-rwasm.R and
# design/howto-build-rbest-webr.md), rwasm always invokes this script under
# emconfigure with --host=wasm32-unknown-emscripten -- regardless of any
# Makevars override it may also apply, since it backs up and replaces this
# very file before running it. rstan_config() above writes a PKG_LIBS line built
# from two $(shell ...) calls, RcppParallel::RcppParallelLibs() and
# StanHeaders:::LdFlags(). Both are evaluated by the *host* R, and
# StanHeaders:::LdFlags() unconditionally expands to
#   -L<host RcppParallel>/lib -Wl,-rpath,<same> -ltbb -ltbbmalloc
# no matter whether TBB is usable on the target. wasm-ld then chokes on those
# native ELF objects ("unknown file type: .../libtbb.so"). webR is
# single-threaded and links side modules with
# --unresolved-symbols=import-dynamic, so RBesT needs no library of its own
# here: blank out PKG_LIBS entirely when configure runs for the wasm host
# triplet. This block must survive any future rstantools re-scaffolding of
# this file (e.g. `rstantools::use_rstan()`); re-add it if regenerated.
for arg; do
  case "$arg" in
    --host=wasm32-unknown-emscripten)
      sed -i.bak -e 's/^PKG_LIBS *=.*/PKG_LIBS =/' src/Makevars
      rm -f src/Makevars.bak
      echo "configure: blanked PKG_LIBS in src/Makevars for the wasm host triplet"
      ;;
  esac
done

# Never let the exit status fall out of the loop above; see the note by `set -e`.
exit 0
